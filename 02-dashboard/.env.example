# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings → API → anon / public key. Safe in the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Settings → API → service_role key. SERVER AND SEED SCRIPT ONLY.
# This key bypasses row-level security entirely. It must never reach the browser,
# never appear in a NEXT_PUBLIC_ variable, and never be committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Passwords for the two seeded demo accounts (see README → A way in).
SEED_USER_A_EMAIL=owner-a@example.com
SEED_USER_A_PASSWORD=change-me
SEED_USER_B_EMAIL=owner-b@example.com
SEED_USER_B_PASSWORD=change-me
