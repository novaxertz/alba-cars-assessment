# Copy to .env.local if you want plain-language recall summaries.
# NOTHING HERE IS REQUIRED — the app runs fully without any keys, because NHTSA
# needs none. Without a key, recall notices show NHTSA's own wording.

# Optional. Server-side only: this is read in the route handler and is never
# serialised to the browser. Never commit a real value.
ANTHROPIC_API_KEY=sk-ant-your-key-here
